<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.WaypointGoHome" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorOutline">@color/outline</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/primary_dark</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.WaypointGoHome.Square</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.WaypointGoHome.Square</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.WaypointGoHome.Square</item>
        <item name="materialButtonStyle">@style/Widget.WaypointGoHome.Button</item>
    </style>

    <style name="ThemeOverlay.WaypointGoHome.Toolbar" parent="ThemeOverlay.Material3.Dark.ActionBar" />

    <style name="ShapeAppearance.WaypointGoHome.Square" parent="ShapeAppearance.Material3.Corner.None">
        <item name="cornerSize">0dp</item>
    </style>

    <style name="Widget.WaypointGoHome.Button" parent="Widget.Material3.Button">
        <item name="shapeAppearance">@style/ShapeAppearance.WaypointGoHome.Square</item>
    </style>

    <style name="Widget.WaypointGoHome.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="shapeAppearance">@style/ShapeAppearance.WaypointGoHome.Square</item>
        <item name="strokeColor">@color/outline</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <style name="TextAppearance.WaypointGoHome.Heading" parent="android:TextAppearance">
        <item name="android:fontFamily">@font/barlow_condensed</item>
        <item name="android:textFontWeight" tools:targetApi="p">600</item>
    </style>
</resources>
